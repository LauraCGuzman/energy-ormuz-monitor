# Plantilla de secretos para Streamlit.
#
# 1. Copia este archivo a `secrets.toml` en la misma carpeta.
# 2. Rellena los valores reales.
# 3. NUNCA commitees el archivo `secrets.toml` real (ya está en .gitignore).
#
# Para el despliegue en Streamlit Community Cloud, estos valores se
# configuran en la interfaz web del proyecto (Settings > Secrets).

GIE_API_KEY = "TU_API_KEY_DE_GIE_AQUI"
EIA_API_KEY= "TU_API_KEY_DE_EIA_AQUI"